#!/bin/bash
set -u

# Extend Omarchy's 1-100 brightness range with software dimming.
# Logical 1-20: hardware stays at 1%, hyprsunset gamma spans 5-100%.
# Logical 21-100: gamma stays at 100%, hardware spans 2-100%.
no_osd=0
monitor=""
map_only=""
watch_gamma=0
watch_once=0

while (( $# > 0 )); do
  case "$1" in
    --no-osd) no_osd=1; shift ;;
    --monitor) (( $# >= 2 )) || exit 1; monitor="$2"; shift 2 ;;
    --map) (( $# >= 2 )) || exit 1; map_only="$2"; shift 2 ;;
    --watch-gamma) watch_gamma=1; shift ;;
    --watch-gamma-once) watch_gamma=1; watch_once=1; shift ;;
    *) break ;;
  esac
done

state_root="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/brightness-extra-dark"
desired_gamma_file="$state_root/desired-gamma"
self="$(readlink -f -- "${BASH_SOURCE[0]}")"

enforce_gamma() {
  local desired current
  [[ -r $desired_gamma_file ]] || return 0
  IFS= read -r desired <"$desired_gamma_file"
  [[ $desired =~ ^[0-9]+$ ]] || return 0
  current="$(hyprctl hyprsunset gamma 2>/dev/null | grep -oE '[0-9]+' | head -n1 || true)"
  if [[ $current != "$desired" ]]; then
    hyprctl hyprsunset gamma "$desired" >/dev/null 2>&1 || true
  fi
}

if (( watch_gamma )); then
  while :; do
    enforce_gamma
    (( watch_once )) && exit 0
    sleep 2
  done
fi

[[ -n $monitor ]] || monitor="$(omarchy-hyprland-monitor-focused 2>/dev/null || true)"
[[ -n $monitor ]] || exit 1

state_file="$state_root/${monitor//\//_}"

clamp() {
  local n="${1%%%}"
  [[ $n =~ ^[0-9]+$ ]] || return 1
  (( n < 1 )) && n=1
  (( n > 100 )) && n=100
  printf '%s\n' "$n"
}

map_values() {
  local logical=$1 hardware gamma
  if (( logical <= 20 )); then
    hardware=1
    gamma=$(( 5 + (logical - 1) * 95 / 19 ))
  else
    gamma=100
    hardware=$(( 1 + (logical - 20) * 99 / 80 ))
  fi
  printf '%s %s\n' "$hardware" "$gamma"
}

if [[ -n $map_only ]]; then
  logical="$(clamp "$map_only")" || exit 1
  map_values "$logical"
  exit
fi

if (( $# == 0 )); then
  if [[ -r $state_file ]]; then
    IFS= read -r saved <"$state_file"
    if logical="$(clamp "$saved")"; then
      printf '%s\n' "$logical"
      exit
    fi
  fi
  omarchy-brightness-display --monitor "$monitor"
  exit
fi

logical="$(clamp "$1")" || exit 1
read -r hardware gamma < <(map_values "$logical")

# Restore software gamma before increasing physical light; dim physical light
# before applying extra gamma. This avoids a bright flash at the crossover.
if (( gamma == 100 )); then
  hyprctl hyprsunset gamma 100 >/dev/null 2>&1 || exit 1
  omarchy-brightness-display --no-osd --monitor "$monitor" "$hardware%" || exit 1
else
  omarchy-brightness-display --no-osd --monitor "$monitor" "$hardware%" || exit 1
  hyprctl hyprsunset gamma "$gamma" >/dev/null 2>&1 || exit 1
fi

mkdir -p "$state_root"
printf '%s\n' "$logical" >"$state_file"
printf '%s\n' "$gamma" >"$desired_gamma_file.tmp"
mv -f -- "$desired_gamma_file.tmp" "$desired_gamma_file"

# hyprsunset profiles and other desktop controls can reset gamma after this
# command succeeds. Keep the slider's requested gamma authoritative for the
# rest of the graphical session, without repeatedly writing when it matches.
if ! systemctl --user is-active --quiet omarchy-display-toggle-gamma.service 2>/dev/null; then
  if ! systemd-run --user --unit=omarchy-display-toggle-gamma --collect \
    --property=Restart=on-failure --property=RestartSec=1 \
    "$self" --watch-gamma >/dev/null 2>&1; then
    nohup "$self" --watch-gamma >/dev/null 2>&1 &
  fi
fi

(( no_osd )) || omarchy-osd -i brightness -p "$logical"
printf '%s\n' "$logical"
